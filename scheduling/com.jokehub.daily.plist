<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每日笑话流水线 launchd 示例（默认未安装）。
  安装前把 /path/to/joke-hub 改为实际仓库路径；launchd 按系统本地时区解释
  StartCalendarInterval，机器非上海时区时请自行换算（详见 scheduling/README.md）。
  07:20/08:05 两轮为生产准备（未到门禁时以 exit 3 结束，内容幂等就绪）；
  09:00/09:37/10:07 三轮在门禁后发布并核验（发布有分钟级耗时，不承诺秒级
  准点）；已发布日重跑为幂等核验。调度环境须通过 EnvironmentVariables 把
  JOKE_SITE_URL 设为实际网站地址，否则核验只探测 localhost 会失败。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jokehub.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /path/to/joke-hub &amp;&amp; npm run daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>37</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/jokehub-daily-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/jokehub-daily-launchd.log</string>
  <key>Timeout</key>
  <integer>3600</integer>
</dict>
</plist>
