# Supabase 持久化配置（全部为 server-only，绝不进入前端代码或提交到仓库）
# 不配置以下变量时，网站回退到本地 SQLite 模式（data/jokes.sqlite）。

# Supabase 项目 URL（Project Settings -> Data API -> Project URL）
SUPABASE_URL=

# anon / publishable key（Project Settings -> API Keys -> Publishable key）
# 仅用于服务端读取，受 RLS 限制只能读到 published 内容
SUPABASE_ANON_KEY=

# service key（Project Settings -> API Keys -> Secret key）
# 仅用于 content:import / supabase-verify 等 CLI 写入，绝不能配置到网站运行时前端
SUPABASE_SERVICE_KEY=

# 本地 SQLite 库文件路径（可选，默认 data/jokes.sqlite）
# JOKES_DB_PATH=
